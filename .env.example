# ═══════════════════════════════════════════════════════════════════════════
# VIHARA AI - Docker Deployment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# APPLICATION ENVIRONMENT
# ───────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# ───────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (PostgreSQL)
# ───────────────────────────────────────────────────────────────────────────
DB_USER=vihara
DB_PASSWORD=secure_password_123
DB_NAME=vihara_db
DB_PORT=5432

# Full PostgreSQL URL (auto-generated in docker-compose, override if needed)
# DATABASE_URL=postgresql+asyncpg://vihara:secure_password_123@postgres:5432/vihara_db

# ───────────────────────────────────────────────────────────────────────────
# REDIS CACHE CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secure_123
REDIS_PORT=6379

# Full Redis URL (auto-generated in docker-compose, override if needed)
# REDIS_URL=redis://:redis_secure_123@redis:6379/0

# ───────────────────────────────────────────────────────────────────────────
# QDRANT VECTOR DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=qdrant_secure_key_123
QDRANT_PORT=6333

# ───────────────────────────────────────────────────────────────────────────
# AI/ML API KEYS (Required)
# ───────────────────────────────────────────────────────────────────────────
# Groq API Key - Get free at: https://console.groq.com
# Used for: Chat, Planner, Voice synthesis
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace API Token - Get free at: https://huggingface.co/settings/tokens
# Used for: Vision/Image scanning, NLP models
HUGGINGFACE_API_TOKEN=hf_your_huggingface_token_here

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: CLOUDINARY (Image Storage & Processing)
# ───────────────────────────────────────────────────────────────────────────
# Get free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───────────────────────────────────────────────────────────────────────────
# SECURITY
# ───────────────────────────────────────────────────────────────────────────
# JWT Secret Key - Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_change_this_in_production_12345

# ───────────────────────────────────────────────────────────────────────────
# PORT CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=80

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: CORS & SECURITY
# ───────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: LOGGING
# ───────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ───────────────────────────────────────────────────────────────────────────
# NOTES
# ───────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env in the root directory
# 2. Replace placeholder values with real API keys
# 3. Use strong passwords (20+ characters with mix of letters, numbers, symbols)
# 4. NEVER commit .env to version control
# 5. For production, use environment-specific .env files (.env.prod, .env.staging)
